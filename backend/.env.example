# Copy to backend/.env on each laptop and replace the placeholders.
# Do not commit backend/.env.
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-web-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:3005
TOKEN_ENCRYPTION_KEY=replace-with-generated-fernet-key
SECRET_KEY=replace-with-long-random-private-value
FACE_SIMILARITY_THRESHOLD=0.6
DB_PATH=data/app.db
